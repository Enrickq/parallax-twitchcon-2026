# Copy to .env and source it before running, or export variables in your shell.
# Safe default: local-only demo on port 3000. No Twitch credentials required.
PORT=3000
HOST=127.0.0.1

# For ACTUAL Twitch chat, use a valid Twitch user OAuth access token with chat:read.
# Never publish or commit your token. The NICK must match the token owner.
TWITCH_CHANNEL=
TWITCH_BOT_USERNAME=
TWITCH_OAUTH_TOKEN=

# Required when HOST=0.0.0.0 / deploying publicly, protects streamer controls.
CONTROL_KEY=
